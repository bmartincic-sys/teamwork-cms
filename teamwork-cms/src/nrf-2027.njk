<script>
(function () {
  var box = document.getElementById('lxCount');
  if (!box) return;
  var note = document.getElementById('lxCountNote');
  var target = new Date(box.getAttribute('data-reveal')).getTime();
  var f = { d: box.querySelector('[data-d]'), h: box.querySelector('[data-h]'), m: box.querySelector('[data-m]'), s: box.querySelector('[data-s]') };
  var pad = function (n) { return n < 10 ? '0' + n : String(n); };
  function tick() {
    var left = target - Date.now();
    if (left <= 0) {
      f.d.textContent = '00'; f.h.textContent = '00'; f.m.textContent = '00'; f.s.textContent = '00';
      if (note) note.textContent = 'The sun is up. Booth #6156 is open.';
      return;
    }
    var s = Math.floor(left / 1000);
    f.d.textContent = String(Math.floor(s / 86400));
    f.h.textContent = pad(Math.floor((s % 86400) / 3600));
    f.m.textContent = pad(Math.floor((s % 3600) / 60));
    f.s.textContent = pad(s % 60);
    setTimeout(tick, 1000 - (Date.now() % 1000));
  }
  tick();
})();
</script>
