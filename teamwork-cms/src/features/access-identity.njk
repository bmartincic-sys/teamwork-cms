<!-- ============ WHY IT MATTERS ============ -->
<section class="tm-band">
  <div class="tm-band-glow"></div>
  <div class="container">
    <div class="section-header" style="text-align: center;">
      <div class="section-eyebrow">Why Identity Matters</div>
      <h2 class="section-title">Shared logins are a shrink problem.</h2>
      <p class="section-sub">When several associates share one credential, nothing is attributable, and internal theft is a material share of total shrink.</p>
    </div>
    <div class="stat-row-4" style="grid-template-columns: repeat(3, 1fr);">
      <div class="statcard statcard-blue">
        <div class="statcard-value"><span class="counter" data-target="29" data-suffix="%">29%</span></div>
