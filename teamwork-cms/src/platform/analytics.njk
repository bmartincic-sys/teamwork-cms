<script>
(function () {
  var targets = [
    [document.querySelector('.dashw-grid'), 'dash-run'],
    [document.querySelector('.rptdoc'), 'rpt-run']
  ].filter(function (t) { return t[0]; });
  if (!targets.length) return;
  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (t) { t[0].classList.add(t[1]); });
    return;
  }
  targets.forEach(function (t) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { t[0].classList.toggle(t[1], e.isIntersecting); });
    }, { threshold: 0.12 });
    io.observe(t[0]);
  });
})();
</script>

