<script>
(function () {
  var root = document.querySelector("[data-jx]");
  if (!root) return;
  var steps = [].slice.call(root.querySelectorAll(".jx-step"));
  var screens = [].slice.call(root.querySelectorAll(".jx-screen"));
  var dots = [].slice.call(root.querySelectorAll(".jx-rail-dot"));
  var time = root.querySelector(".jx-time");
  var capZone = root.querySelector(".jx-caption-zone");
  var capStep = root.querySelector(".jx-caption-step");
  var zoneNames = { open: "Opening", floor: "The floor", fitting: "Fitting room", pay: "Checkout", back: "Back of house", close: "Close" };
  var current = null;
  function show(step) {
    if (step === current) return; current = step;
    var stage = step.getAttribute("data-stage"), zone = step.getAttribute("data-zone");
    screens.forEach(function (s) { s.classList.toggle("is-on", s.getAttribute("data-stage") === stage); });
    steps.forEach(function (s) { s.classList.toggle("is-on", s === step); });
    dots.forEach(function (d) { d.classList.toggle("is-on", d.getAttribute("data-zone") === zone); });
    if (time) time.textContent = step.getAttribute("data-time");
    if (capZone) capZone.textContent = zoneNames[zone] || "";
    if (capStep) capStep.textContent = stage + " / " + steps.length;
  }
  show(steps[0]);
  if (!("IntersectionObserver" in window)) return;
  // the step whose centre is nearest the middle of the viewport wins
  var io = new IntersectionObserver(function () {
    var mid = window.innerHeight * 0.5, best = null, bestD = Infinity;
    steps.forEach(function (s) {
      var r = s.getBoundingClientRect(); var c = r.top + r.height / 2; var d = Math.abs(c - mid);
      if (r.bottom > 0 && r.top < window.innerHeight && d < bestD) { bestD = d; best = s; }
    });
    if (best) show(best);
  }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
  steps.forEach(function (s) { io.observe(s); });
  var ticking = false;
  window.addEventListener("scroll", function () {
    if (ticking) return; ticking = true;
    requestAnimationFrame(function () { ticking = false; io.takeRecords(); var mid = window.innerHeight * 0.5, best = null, bestD = Infinity;
      steps.forEach(function (s) { var r = s.getBoundingClientRect(); var c = r.top + r.height / 2; var d = Math.abs(c - mid); if (r.bottom > 0 && r.top < window.innerHeight && d < bestD) { bestD = d; best = s; } });
      if (best) show(best); });
  }, { passive: true });
})();
</script>
