      <span class="jx-rail-dot" data-zone="open">Opening</span>
      <span class="jx-rail-dot" data-zone="floor">The floor</span>
      <span class="jx-rail-dot" data-zone="fitting">Fitting room</span>
      <span class="jx-rail-dot" data-zone="pay">Checkout</span>
      <span class="jx-rail-dot" data-zone="back">Back of house</span>
