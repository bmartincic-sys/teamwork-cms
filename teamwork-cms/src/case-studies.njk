---
layout: "solution.njk"
title: "Case Studies | Teamwork Commerce"
description: "Every Teamwork Commerce customer story — ASICS, Petco, FAO Schwarz, Moose Knuckles, Sports Basement, the Carolina Hurricanes, Colorado Rockies, Prada Shoes, Paul Stuart and more."
navLabel: "Case Studies"
tags: "resources"
permalink: "/case-studies/"
---
<!-- Breadcrumb -->
<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb" style="padding: 16px 0; font-size: 12px; color: var(--text-faint);">
    <a href="/" style="color: var(--text-muted);">Home</a> <span style="margin: 0 6px;">/</span>
    Case Studies
  </nav>
</div>

<!-- ============ HERO ============ -->
<section class="hero hero-shot">
  <img class="hero-shot-bg" src="/assets/images/homepage/case-studies-hero.jpg" alt="A jewelry boutique associate completing a sale on the iPad POS with a customer-facing display" style="object-position: 52% 42%;">
  <div class="hero-shot-scrim"></div>
  <div class="container hero-inner fade-up">
    <span class="eyebrow"><span class="eyebrow-dot"></span> Case Studies</span>
    <h1>The proof is on the <span class="accent">sales floor.</span></h1>
    <p class="hero-sub">
      {{ caseStudies.length }} stories from the brands that run their stores on Teamwork Commerce — global athletic labels, luxury houses, pro sports franchises, and multi-hundred-store fleets.
    </p>
    <div class="csx-hero-stats">
      <div><strong>{{ caseStudies.length }}</strong><span>Published stories</span></div>
      <div><strong>30K+</strong><span>Terminals live</span></div>
      <div><strong>40+</strong><span>Countries</span></div>
      <div><strong>99.99%</strong><span>Uptime</span></div>
    </div>
    <div class="hero-cta">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a demo <i class="ti ti-arrow-right"></i></a>
      <a href="#all-stories" class="btn btn-ghost btn-lg">Browse every story</a>
    </div>
  </div>
</section>

<!-- ============ ALL STORIES (filterable) ============ -->
<section class="section" id="all-stories">
  <div class="container">
    {% set sectors = [] %}
    {% for cs in caseStudies %}{% if cs.sector not in sectors %}{% set sectors = (sectors.push(cs.sector), sectors) %}{% endif %}{% endfor %}

    <div class="csx-filters" role="tablist" aria-label="Filter case studies by sector">
      <button class="csx-filter is-active" data-filter="all" role="tab" aria-selected="true">All <span>{{ caseStudies.length }}</span></button>
      {% for sec in sectors %}
      <button class="csx-filter" data-filter="{{ sec | slugify }}" role="tab" aria-selected="false">{{ sec }}</button>
      {% endfor %}
    </div>

    <div class="csx-grid" id="csGrid">
      {% for cs in caseStudies %}
      <a class="csx-card{% if cs.photo %} has-photo{% else %} is-ink tone-{{ loop.index0 % 3 }}{% endif %}" href="{{ cs.url }}"{% if cs.external %} target="_blank" rel="noopener"{% endif %} data-sector="{{ cs.sector | slugify }}">
        {% if cs.photo %}<img class="csx-photo" src="{{ cs.photo }}" alt="{{ cs.client }}" loading="lazy">{% endif %}
        <div class="csx-scrim"></div>
        <span class="csx-sector">{{ cs.sector }}</span>
        {% if cs.external %}<i class="ti ti-external-link csx-ext"></i>{% endif %}
        <div class="csx-body">
          {% if cs.logo %}<img class="csx-logo" src="{{ cs.logo }}" alt="{{ cs.client }}">{% else %}<span class="csx-name">{{ cs.client }}</span>{% endif %}
          <h3>{{ cs.title }}</h3>
          {% if cs.result %}<span class="csx-result"><i class="ti {{ cs.resultIcon }}"></i> {{ cs.result }}</span>{% endif %}
          <div class="csx-more">
            <p>{{ cs.blurb }}</p>
            <span class="csx-read">Read the case study <i class="ti ti-arrow-right"></i></span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    <p class="csx-empty" id="csEmpty" hidden>No stories in that sector yet.</p>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">In Their Words</div>
      <h2 class="section-title">Customers who put us to the test.</h2>
    </div>
    <div class="pillars-grid" style="grid-template-columns: repeat(2, 1fr);">
      <div class="pillar-card">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--brand-text); margin-bottom: 16px;">Turnbull &amp; Asser &middot; UK Implementation</div>
        <p style="font-size: 16px; color: var(--text); line-height: 1.7; font-style: italic; margin-bottom: 20px; position: relative; z-index: 1;">"We implemented Teamwork POS through our UK and US store portfolio between 2016 and 2018. A big undertaking for any business, the implementation and development team worked alongside us and other 3rd party partners to deliver the project. Teamwork has shown a willingness to go above and beyond to ensure we have a product which fits our business."</p>
        <div style="font-size: 13px; font-weight: 700; color: var(--brand-text); position: relative; z-index: 1;">— Lewis Hamilton, Head of Ecommerce, Turnbull &amp; Asser</div>
      </div>
      <div class="pillar-card">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--brand-text); margin-bottom: 16px;">Hat Club &middot; Inventory Management</div>
        <p style="font-size: 16px; color: var(--text); line-height: 1.7; font-style: italic; margin-bottom: 20px; position: relative; z-index: 1;">"Teamwork has allowed us to match our POS system with the image of our stores and the product we sell. Additionally, the system has allowed us to manage our inventory as well as make more informed decisions that has led to greater efficiencies and higher profit margins."</p>
        <div style="font-size: 13px; font-weight: 700; color: var(--brand-text); position: relative; z-index: 1;">— Stephen Stachel, President, Hat Club</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section class="final-cta">
  <div class="container final-cta-inner">
    <h2>Want to be the next <span class="gradient-text">success story?</span></h2>
    <p>See what Teamwork Commerce can do for your stores.</p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/contact/" class="btn btn-primary btn-lg">Book a demo <i class="ti ti-arrow-right"></i></a>
    </div>
  </div>
</section>

<script>
(function () {
  var filters = document.querySelectorAll(".csx-filter");
  var cards = document.querySelectorAll("#csGrid .csx-card");
  var empty = document.getElementById("csEmpty");
  if (!filters.length || !cards.length) return;

  filters.forEach(function (btn) {
    btn.addEventListener("click", function () {
      var want = btn.getAttribute("data-filter");
      filters.forEach(function (b) {
        var on = b === btn;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      var shown = 0;
      cards.forEach(function (c) {
        var match = want === "all" || c.getAttribute("data-sector") === want;
        c.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
})();
</script>
