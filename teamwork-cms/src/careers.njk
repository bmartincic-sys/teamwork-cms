<!-- ============ HERO ============ -->
<section class="section" style="padding-bottom: 40px;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center;">
      <div>
        <span class="eyebrow"><span class="eyebrow-dot"></span> Careers</span>
        <h1 style="font-size: clamp(38px, 5.4vw, 62px); font-weight: 600; letter-spacing: -0.04em; line-height: 1.04; margin: 18px 0 0;">
