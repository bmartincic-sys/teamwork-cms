<!-- ============ REQUEST FORM ============ -->
<section class="section" id="request">
  <div class="container">
    <div class="tev-grid">
      <div class="tev-copy">
        <div class="section-eyebrow">Request a Technical Review</div>
        <h2 class="section-title" style="font-size: clamp(26px, 3.2vw, 38px);">Send us the questions in advance.</h2>
        <p class="section-sub" style="margin-bottom: 26px;">Tell us what you need covered and who needs to be on the call, and we will bring the right engineers.</p>
        <ul class="lead-points">
          <li><i class="ti ti-user-check"></i> Solutions architects and integration engineers, not an AE</li>
          <li><i class="ti ti-file-description"></i> Send your security questionnaire ahead of time</li>
          <li><i class="ti ti-lock"></i> Your details stay with us, no list sharing</li>
        </ul>
      </div>

      <div class="tev-formwrap">
        <form name="technical-evaluation" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
                  <input type="hidden" name="form-name" value="technical-evaluation">
                  <p hidden><label>Leave this empty: <input name="bot-field"></label></p>

                  <div class="tev-row">
                    <div class="tev-field">
                      <label for="tev-name">Name *</label>
                      <input id="tev-name" type="text" name="name" required placeholder="Jane Smith">
                    </div>
                    <div class="tev-field">
                      <label for="tev-title">Role *</label>
                      <input id="tev-title" type="text" name="job_title" required placeholder="VP Architecture">
                    </div>
                  </div>

                  <div class="tev-row">
                    <div class="tev-field">
                      <label for="tev-email">Work email *</label>
                      <input id="tev-email" type="email" name="work_email" required placeholder="jane@company.com">
                    </div>
                    <div class="tev-field">
                      <label for="tev-company">Company *</label>
                      <input id="tev-company" type="text" name="company" required placeholder="Your company">
                    </div>
                  </div>

                  <div class="tev-row">
                    <div class="tev-field">
                      <label for="tev-stores">Stores in scope</label>
                      <select id="tev-stores" name="store_count">
                        <option value="">Select…</option>
                        <option>1–50</option>
                        <option>51–200</option>
                        <option>201–500</option>
                        <option>501–1,000</option>
                        <option>1,000+</option>
                      </select>
                    </div>
                    <div class="tev-field">
                      <label for="tev-markets">Markets</label>
                      <select id="tev-markets" name="markets">
                        <option value="">Select…</option>
                        <option>Single market</option>
                        <option>2–5</option>
                        <option>6–15</option>
                        <option>16+</option>
                      </select>
                    </div>
                  </div>

                  <div class="tev-field" style="margin-bottom: 18px;">
                    <span class="tev-legend">What should we cover?</span>
                    <div class="tev-checks">
                      <label><input type="checkbox" name="topics" value="Architecture &amp; hosting"> Architecture &amp; hosting</label>
                      <label><input type="checkbox" name="topics" value="Security review"> Security review</label>
                      <label><input type="checkbox" name="topics" value="Integration mapping"> Integration mapping</label>
                      <label><input type="checkbox" name="topics" value="Migration &amp; cutover"> Migration &amp; cutover</label>
                      <label><input type="checkbox" name="topics" value="Identity &amp; access"> Identity &amp; access</label>
                      <label><input type="checkbox" name="topics" value="Devices &amp; fleet ops"> Devices &amp; fleet ops</label>
                    </div>
                  </div>

                  <div class="tev-field" style="margin-bottom: 18px;">
                    <label for="tev-stack">Current stack</label>
                    <input id="tev-stack" type="text" name="current_stack" placeholder="Incumbent POS, ERP, e-commerce, OMS, payments">
                  </div>

                  <div class="tev-field" style="margin-bottom: 20px;">
                    <label for="tev-notes">Anything specific you need answered?</label>
                    <textarea id="tev-notes" name="message" rows="3" placeholder="Timelines, constraints, the question that will decide this…"></textarea>
                  </div>

                  <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">Request a technical review <i class="ti ti-arrow-right"></i></button>
                  <p class="tev-fine">A solutions architect responds within one business day. By submitting, you agree to our <a href="/privacy-policy/">Privacy Policy</a>.</p>
                </form>
      </div>
    </div>
  </div>
</section>
