<!-- ============ FORM FIRST ============
  The form is the page. Competitor demo pages put supporting content above it and
  make you scroll to convert; this one leads with it and keeps the proof alongside. -->
<section class="section demox" style="padding-bottom: 40px;">
  <div class="container">
    <div class="demox-grid">
      <div class="demox-copy">
        <span class="eyebrow"><span class="eyebrow-dot"></span> Book a Demo</span>
        <h1 class="demox-h1">See it running against <span class="gradient-text">your own operation.</span></h1>
        <p class="demox-sub">Tell us how your stores actually work and a retail solutions architect will walk through the platform against it. Your assortment, your markets, your edge cases.</p>

        <ul class="demox-points">
          <li><i class="ti ti-user-check"></i><div><strong>A solutions architect, not an account executive</strong><span>Someone who can answer the awkward question in the room rather than take it away.</span></div></li>
          <li><i class="ti ti-clock-hour-4"></i><div><strong>45 minutes, and an agenda you set</strong><span>Tell us what matters and we will skip the rest. No generic product tour.</span></div></li>
          <li><i class="ti ti-device-ipad"></i><div><strong>The real product on real devices</strong><span>Live POS, RFID counting and fulfilment, not screenshots in a deck.</span></div></li>
          <li><i class="ti ti-lock"></i><div><strong>Your details stay with us</strong><span>No list sharing, and no sequence of chase emails afterwards.</span></div></li>
        </ul>

        <div class="demox-promise">
          <i class="ti ti-mail-fast"></i>
          <span>A solutions architect replies <strong>within one business day.</strong> If we are not the right fit for what you need, we will tell you that instead of booking the call.</span>
        </div>
      </div>

      <div class="demox-formwrap" id="request">
        <div class="demox-formhead">
          <h2>Request your session</h2>
          <p>Four fields to get started. Everything below them is optional and only helps us come prepared.</p>
        </div>

        <form name="demo-request" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="demo-request">
          <p hidden><label>Leave this empty: <input name="bot-field"></label></p>

          <div class="dfx-row">
            <div class="dfx-field">
              <label for="dfx-first">First name *</label>
              <input id="dfx-first" type="text" name="first_name" required placeholder="Jane">
            </div>
            <div class="dfx-field">
              <label for="dfx-last">Last name *</label>
              <input id="dfx-last" type="text" name="last_name" required placeholder="Smith">
            </div>
          </div>

          <div class="dfx-row">
            <div class="dfx-field">
              <label for="dfx-email">Work email *</label>
              <input id="dfx-email" type="email" name="work_email" required placeholder="jane@company.com">
            </div>
            <div class="dfx-field">
              <label for="dfx-company">Company *</label>
              <input id="dfx-company" type="text" name="company" required placeholder="Your company">
            </div>
          </div>

          <details class="dfx-more">
            <summary>Add detail so we can come prepared <span>optional</span></summary>

            <div class="dfx-row">
              <div class="dfx-field">
                <label for="dfx-role">Role</label>
                <input id="dfx-role" type="text" name="job_title" placeholder="VP of Retail">
              </div>
              <div class="dfx-field">
                <label for="dfx-phone">Phone</label>
                <input id="dfx-phone" type="tel" name="phone" placeholder="+1 (555) 000-0000">
              </div>
            </div>

            <div class="dfx-row">
              <div class="dfx-field">
                <label for="dfx-stores">Stores in scope</label>
                <select id="dfx-stores" name="store_count">
                  <option value="">Select&hellip;</option>
                  <option>1&ndash;50</option>
                  <option>51&ndash;200</option>
                  <option>201&ndash;500</option>
                  <option>501&ndash;1,000</option>
                  <option>1,000+</option>
                </select>
              </div>
              <div class="dfx-field">
                <label for="dfx-industry">Industry</label>
                <select id="dfx-industry" name="industry">
                  <option value="">Select&hellip;</option>
                  <option>Fashion &amp; apparel</option>
                  <option>Luxury</option>
                  <option>Footwear</option>
                  <option>Jewelry &amp; watches</option>
                  <option>Museums &amp; cultural</option>
                  <option>Pet retail</option>
                  <option>Stadiums &amp; venues</option>
                  <option>Other</option>
                </select>
              </div>
            </div>

            <div class="dfx-field">
              <span class="dfx-legend">What would you like to see?</span>
              <div class="dfx-checks">
                <label><input type="checkbox" name="interest" value="Mobile POS"> Mobile POS</label>
                <label><input type="checkbox" name="interest" value="RFID"> RFID &amp; self-checkout</label>
                <label><input type="checkbox" name="interest" value="Order Management"> Order management</label>
                <label><input type="checkbox" name="interest" value="Inventory Control"> Inventory control</label>
                <label><input type="checkbox" name="interest" value="121 Commerce (AI)"> AI at the point of sale</label>
                <label><input type="checkbox" name="interest" value="Analytics"> Analytics &amp; reporting</label>
              </div>
            </div>

            <div class="dfx-field">
              <label for="dfx-msg">Anything specific we should cover?</label>
              <textarea id="dfx-msg" name="message" rows="3" placeholder="Current stack, timeline, the workflow that keeps breaking&hellip;"></textarea>
            </div>
          </details>

          <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center; margin-top: 8px;">Request a demo <i class="ti ti-arrow-right"></i></button>
          <p class="dfx-fine">By submitting, you agree to our <a href="/privacy-policy/">Privacy Policy</a>. Prefer email? <a href="mailto:sales@teamworkcommerce.com">sales@teamworkcommerce.com</a></p>
          <input type="hidden" name="source" id="dfx-source" value="">
        </form>
      </div>
    </div>
  </div>
</section>

