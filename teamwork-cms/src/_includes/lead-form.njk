<!-- ============ LEAD FORM (HubSpot) ============ -->
<section class="lead-band" id="get-in-touch">
  <div class="lead-glow"></div>
  <div class="container lead-inner">
    <div class="lead-copy">
      <div class="section-eyebrow">{{ leadEyebrow | default("Talk to Us") }}</div>
      <h2 class="lead-h2">{{ leadTitle | default("See it on your own numbers.") }}</h2>
      <p class="lead-sub">{{ leadSub | default("Tell us how many stores you run and what you are replacing, and a solutions architect will walk you through the platform against your actual operation, no generic demo.") }}</p>
      <ul class="lead-points">
        <li><i class="ti ti-clock"></i> A working session, not a slide deck</li>
        <li><i class="ti ti-user-check"></i> Straight to a solutions architect who knows retail</li>
        <li><i class="ti ti-lock"></i> Your details stay with us, no list sharing</li>
      </ul>
    </div>
    <div class="lead-formwrap is-embed">
      {#
        The demo form, same as /demo/. It renders in a cross-origin iframe, so the
        page can no longer stamp the vertical into a hidden field the way the old
        v2 embed did. The vertical is still known here ({{ vertical | default("general") }})
        and can be carried again by adding a hidden field in HubSpot with
        query-string prefill turned on.
      #}
      <script src="https://js.hsforms.net/forms/embed/50295934.js" defer></script>
      <div class="hs-form-frame" data-region="na1" data-form-id="8cb1e7a4-1518-41b3-8611-9a195587d09f" data-portal-id="50295934"></div>
    </div>
  </div>
</section>

{% include "sticky-cta.njk" %}
