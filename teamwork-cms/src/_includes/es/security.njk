<!-- ============ SECURITY & COMPLIANCE (shared) ============ -->
<section class="ac-magenta security-tinted-split">
  <div class="container security-split">
    <div class="security-split-text">
      <div class="section-eyebrow">Seguridad y cumplimiento</div>
      <h2 class="section-title">Conforme con SOC 2, PCI DSS y <span class="gradient-text">GDPR.</span></h2>
      <p class="section-sub" style="margin: 0;">Verificado de forma independiente frente a los estándares que exigen sus equipos de seguridad, finanzas y legal, en los mercados donde operamos.</p>
      {% if page.url != "/technical-evaluation/" %}
      <a href="/technical-evaluation/" class="security-tech-link">Traiga su cuestionario de seguridad <i class="ti ti-arrow-right"></i></a>
      {% endif %}
    </div>
    <div class="security-badges-grid">
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/soc-1.png" alt="SOC 1 Tipo 2"></span><span class="security-badge-name">SOC 1 Tipo 2</span></div>
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/soc-2.png" alt="SOC 2 Tipo 2"></span><span class="security-badge-name">SOC 2 Tipo 2</span></div>
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/gdpr.png" alt="GDPR"></span><span class="security-badge-name">GDPR</span></div>
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/pci-dss.png" alt="PCI DSS"></span><span class="security-badge-name">PCI DSS</span></div>
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/nf525-tse.png" alt="NF525 / TSE"></span><span class="security-badge-name">NF525 / TSE</span></div>
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/iso-27001.png" alt="ISO 27001"></span><span class="security-badge-name">ISO 27001</span></div>
      <div class="security-badge"><span class="security-badge-icon"><i class="ti ti-shield-lock" aria-hidden="true"></i></span><span class="security-badge-name">PIPL &#183; China</span></div>
      <div class="security-badge"><span class="security-badge-icon"><img class="security-badge-logo" src="/assets/images/security/mlps.png" alt="MLPS 2.0, estándar chino de cumplimiento en ciberseguridad"></span><span class="security-badge-name">MLPS 2.0 &#183; China</span></div>
    </div>
  </div>
</section>
