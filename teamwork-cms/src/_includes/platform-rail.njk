{% if platformRail %}
{% set railMeta = {
  "mobile-pos": { "label": "Mobile POS", "icon": "ti-device-mobile", "url": "/platform/mobile-pos/", "desc": "The system of record on the sales floor" },
  "rfid": { "label": "RFID & Self-Checkout", "icon": "ti-scan", "url": "/platform/rfid/", "desc": "Item-level accuracy, receiving through checkout" },
  "oms": { "label": "Order Management", "icon": "ti-truck-delivery", "url": "/platform/oms/", "desc": "Order-fill logic, ship-from-store and BOPIS" },
  "inventory-control": { "label": "Inventory Control", "icon": "ti-packages", "url": "/platform/inventory-control/", "desc": "Real-time visibility, full counts in minutes" },
  "cxp": { "label": "Customer Data", "icon": "ti-user-heart", "url": "/features/customer-data/", "desc": "History, preferences and wishlists at the register" },
  "pxp": { "label": "Product Data", "icon": "ti-tag", "url": "/features/product-data/", "desc": "One product record across every channel" },
  "tap": { "label": "Access & Identity", "icon": "ti-shield-lock", "url": "/features/access-identity/", "desc": "Rotating QR sign-in, role-based permissions" },
  "teammate": { "label": "Associate App", "icon": "ti-id-badge-2", "url": "/features/access-identity/", "desc": "One app for the shift, on a shared device" },
  "lms": { "label": "Training", "icon": "ti-school", "url": "/features/training/", "desc": "Role-based courses, assigned automatically" },
  "analytics": { "label": "Analytics & Reporting", "icon": "ti-chart-bar", "url": "/platform/analytics/", "desc": "150+ reports and real-time dashboards" },
  "shopper-display": { "label": "Shopper Display", "icon": "ti-ad-2", "url": "/platform/mobile-pos/#shopper-display", "desc": "A second screen that works the counter" },
  "integrations": { "label": "Integrations & APIs", "icon": "ti-plug-connected", "url": "/platform/integrations/", "desc": "Connects to the systems you already run" },
  "tcs": { "label": "Point of Sale", "icon": "ti-device-tablet", "url": "/platform/mobile-pos/", "desc": "The system of record on the sales floor" }
} %}
<section class="section prail-section">
  <div class="container">
    <div class="prail-head">
      <h2 class="prail-title">Explore the rest of the platform.</h2>
      <p class="prail-sub">{{ platformRailNote or "Each capability referenced above runs on the same platform: one codebase, one version of the truth." }}</p>
    </div>
    <div class="prail-grid">
      {% for slug in platformRail %}
      {% set m = railMeta[slug] %}
      <a class="prail-row" href="{{ m.url }}">
        <span class="prail-ico"><i class="ti {{ m.icon }}"></i></span>
        <span class="prail-text">
          <strong>{{ m.label }}</strong>
          <em>{{ m.desc }}</em>
        </span>
        <i class="ti ti-arrow-right prail-arrow"></i>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
