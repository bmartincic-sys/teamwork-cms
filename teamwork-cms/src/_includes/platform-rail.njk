{% if platformRail %}
{% set railMeta = {
  "mobile-pos": { "label": "Mobile POS", "icon": "ti-device-mobile", "url": "/platform/mobile-pos/" },
  "rfid": { "label": "RFID & Self-Checkout", "icon": "ti-scan", "url": "/platform/rfid/" },
  "oms": { "label": "Order Management", "icon": "ti-truck-delivery", "url": "/platform/oms/" },
  "inventory-control": { "label": "Inventory Control", "icon": "ti-packages", "url": "/platform/inventory-control/" },
  "cxp": { "label": "Customer Data", "icon": "ti-user-heart", "url": "/features/customer-data/" },
  "pxp": { "label": "Product Data", "icon": "ti-tag", "url": "/features/product-data/" },
  "tap": { "label": "Access & Identity", "icon": "ti-shield-lock", "url": "/features/access-identity/" },
  "teammate": { "label": "Associate App", "icon": "ti-id-badge-2", "url": "/features/access-identity/" },
  "lms": { "label": "Training", "icon": "ti-school", "url": "/features/training/" },
  "analytics": { "label": "Analytics & Reporting", "icon": "ti-chart-bar", "url": "/platform/analytics/" },
  "shopper-display": { "label": "Shopper Display", "icon": "ti-ad-2", "url": "/platform/mobile-pos/#shopper-display" },
  "integrations": { "label": "Integrations & APIs", "icon": "ti-plug-connected", "url": "/platform/integrations/" },
  "tcs": { "label": "Point of Sale", "icon": "ti-device-tablet", "url": "/platform/mobile-pos/" }
} %}
<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="prail">
      <div class="prail-head">
        <h2 class="prail-title">Explore the rest of the platform.</h2>
        <p class="prail-sub">{{ platformRailNote or "Each capability referenced above runs on the same platform: one codebase, one version of the truth." }}</p>
      </div>
      <div class="prail-grid">
        {% for slug in platformRail %}
        {% set m = railMeta[slug] %}
        <a class="prail-chip" href="{{ m.url }}">
          <i class="ti {{ m.icon }}"></i>
          <span>{{ m.label }}</span>
          <i class="ti ti-arrow-right prail-arrow"></i>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}
