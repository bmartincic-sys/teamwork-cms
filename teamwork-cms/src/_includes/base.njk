<!-- Theme is applied before Osano so the page does not flash the wrong theme while the
     CMP loads. Safe to run first: it is inline with no src and touches only the theme
     key in localStorage, so it is not something Osano would gate. -->
<script>
(function () {
  // Follow the device's light/dark setting unless the visitor has picked a theme with the
  // toggle, which is saved. If the device setting changes while the page is open and no
  // choice is saved, follow it live.
  var mq = window.matchMedia("(prefers-color-scheme: dark)");
  function system() { return mq.matches ? "dark" : "light"; }
  var saved = null;
  try { saved = localStorage.getItem("theme"); } catch (e) {}
  document.documentElement.setAttribute("data-theme", saved || system());
  if (mq.addEventListener) mq.addEventListener("change", function () {
    var pick = null;
    try { pick = localStorage.getItem("theme"); } catch (e) {}
    if (!pick) {
      document.documentElement.setAttribute("data-theme", system());
      document.dispatchEvent(new Event("themechange"));
    }
  });
})();
</script>

<!-- Osano CMP. This must stay above every other script that has a src: Osano blocks
     third-party scripts by intercepting them as they load, so anything declared earlier
     would run before the CMP exists and set its cookies ungated.
     Note it only intercepts scripts. Stylesheets (<link>) and iframes are not covered,
     so third-party CSS and video embeds still have to be handled in the markup. -->
<script src="https://cmp.osano.com/169lWRSfbjfGi1iTF/bd7c56a3-144c-425f-9298-235bf64c29eb/osano.js"></script>

