{% if "Teamwork Commerce" in title %}{% set pageTitle = title %}{% else %}{% set pageTitle = title + " | Teamwork Commerce" %}{% endif %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://www.teamworkcommerce.com{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}

{#- Translation alternates. Driven by tools/i18n/manifest.json, so a page can
    only advertise a locale that was actually built. Canonical above stays
    self-referencing per locale, which is what Google expects alongside these. -#}
{%- set sourceUrl = translatedFrom or page.url %}
{%- set alternates = i18n.pages[sourceUrl] %}
{%- if alternates %}
<link rel="alternate" hreflang="en" href="https://www.teamworkcommerce.com{{ sourceUrl }}">
{%- for loc, url in alternates %}
<link rel="alternate" hreflang="{{ loc }}" href="https://www.teamworkcommerce.com{{ url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="https://www.teamworkcommerce.com{{ sourceUrl }}">
{%- endif %}

