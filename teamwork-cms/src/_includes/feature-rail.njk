<!-- ============ EXPLORE MORE FEATURES (shared) ============ -->
{% set allFeatures = [
  { "url": "/platform/mobile-pos/", "label": "Mobile POS", "desc": "The register, anywhere on the floor", "icon": "ti-device-mobile", "group": "Sell" },
  { "url": "/platform/rfid/", "label": "RFID & Self-Checkout", "desc": "30 seconds or less, no scanning", "icon": "ti-scan", "group": "Sell" },
  { "url": "/features/product-data/", "label": "Product Data & Catalog", "desc": "One record, every channel", "icon": "ti-tag", "group": "Know" },
  { "url": "/features/customer-data/", "label": "Customer Data & Clienteling", "desc": "Know the customer at checkout", "icon": "ti-user-heart", "group": "Know" },
  { "url": "/platform/analytics/", "label": "Analytics & Reporting", "desc": "150+ reports out of the box", "icon": "ti-chart-bar", "group": "Know" },
  { "url": "/platform/inventory-control/", "label": "Inventory Control", "desc": "99.9% accuracy, counts in minutes", "icon": "ti-packages", "group": "Operate" },
  { "url": "/platform/oms/", "label": "Order Management", "desc": "Ship from anywhere, BOPIS, returns", "icon": "ti-truck-delivery", "group": "Operate" },
  { "url": "/platform/scalability/", "label": "Scaling & Global", "desc": "Stores, markets, volume, people", "icon": "ti-trending-up", "group": "Operate" },
  { "url": "/platform/integrations/", "label": "Integrations & APIs", "desc": "Open APIs into your stack", "icon": "ti-plug-connected", "group": "Operate" },
  { "url": "/features/access-identity/", "label": "Access & Identity", "desc": "Secure logins, one associate app", "icon": "ti-shield-lock", "group": "Team" },
  { "url": "/features/training/", "label": "Training & Certification", "desc": "Role-based, always current", "icon": "ti-school", "group": "Team" }
] %}
{% set featureGroups = [
  { "name": "Sell", "icon": "ti-shopping-cart" },
  { "name": "Know", "icon": "ti-database" },
  { "name": "Operate", "icon": "ti-settings-cog" },
  { "name": "Team", "icon": "ti-users-group" }
] %}
<section class="section-tight" style="border-top: 1px solid var(--border);">
  <div class="container">
    <div class="section-header" style="text-align: center;">
      <div class="section-eyebrow">One Platform</div>
      <h2 class="section-title" style="font-size: clamp(24px, 3vw, 36px);">The rest of the platform.</h2>
      <p class="section-sub">Every capability runs on the same system: one codebase, one version of the truth.</p>
    </div>
    <div class="frail-cols">
      {% for g in featureGroups %}
        {% set items = [] %}
        {% for f in allFeatures %}{% if f.group == g.name and f.url != page.url %}{% set items = (items.push(f), items) %}{% endif %}{% endfor %}
        {% if items.length %}
        <div class="frail-col">
          <div class="frail-head"><i class="ti {{ g.icon }}"></i> {{ g.name }}</div>
          {% for f in items %}
          <a class="frail-row" href="{{ f.url }}">
            <span class="frail-ico"><i class="ti {{ f.icon }}"></i></span>
            <span class="frail-text">
              <strong>{{ f.label }}</strong>
              <em>{{ f.desc }}</em>
            </span>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
