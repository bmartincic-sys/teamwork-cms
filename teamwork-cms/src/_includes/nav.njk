{% set csUrls = [] %}
{% for cs in caseStudies %}{% if not cs.external %}{% set csUrls = (csUrls.push(cs.url), csUrls) %}{% endif %}{% endfor %}
{% set onCaseStudy = page.url == "/case-studies/" or page.url in csUrls %}
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img class="logo-light" src="/assets/images/teamwork-logo-color.svg" alt="Teamwork Commerce">
      <img class="logo-dark" src="/assets/images/teamwork-logo-white.svg" alt="Teamwork Commerce">
    </a>
    <div class="nav-links">
      <div class="nav-item">
        <a href="/platform/tcs/" class="nav-link{% if "/platform/" in page.url or "/solutions/" in page.url %} nav-link-active{% endif %}">Teamwork Commerce Services <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown nav-mega">
          <a href="/platform/tcs/" class="mega-overview{% if page.url == '/platform/tcs/' %} is-current{% endif %}"{% if page.url == '/platform/tcs/' %} aria-current="page"{% endif %}>
            <span class="mega-ov-icon"><i class="ti ti-topology-star-3"></i></span>
            <span class="mega-ov-text">
              <strong>Teamwork Commerce Services</strong>
              <em>The whole platform, one connected system</em>
            </span>
            <i class="ti ti-arrow-right mega-ov-arrow"></i>
          </a>
          <div class="mega-cols">
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-device-mobile"></i> Commerce Apps</div>
              <a href="/platform/mobile-pos/"{% if page.url == '/platform/mobile-pos/' %} class="is-current" aria-current="page"{% endif %}>POS</a>
              <a href="/platform/teammate/"{% if page.url == '/platform/teammate/' %} class="is-current" aria-current="page"{% endif %}>TEAMMATE</a>
            </div>
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-cpu"></i> Commerce Engine</div>
              <a href="/platform/pxp/"{% if page.url == '/platform/pxp/' %} class="is-current" aria-current="page"{% endif %}>PXP · Product</a>
              <a href="/platform/cxp/"{% if page.url == '/platform/cxp/' %} class="is-current" aria-current="page"{% endif %}>CXP · Customer</a>
              <a href="/platform/tap/"{% if page.url == '/platform/tap/' %} class="is-current" aria-current="page"{% endif %}>TAP · Identity</a>
              <a href="/platform/lms/"{% if page.url == '/platform/lms/' %} class="is-current" aria-current="page"{% endif %}>LMS · Training</a>
            </div>
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-settings-cog"></i> Operations</div>
              <a href="/platform/oms/"{% if page.url == '/platform/oms/' %} class="is-current" aria-current="page"{% endif %}>Order Management</a>
              <a href="/platform/inventory-control/"{% if page.url == '/platform/inventory-control/' %} class="is-current" aria-current="page"{% endif %}>Inventory Control</a>
              <a href="/platform/rfid/"{% if page.url == '/platform/rfid/' %} class="is-current" aria-current="page"{% endif %}>RFID Solution</a>
              <a href="/platform/analytics/"{% if page.url == '/platform/analytics/' %} class="is-current" aria-current="page"{% endif %}>Analytics</a>
              <a href="/platform/shopper-services/"{% if page.url == '/platform/shopper-services/' %} class="is-current" aria-current="page"{% endif %}>Shopper Services</a>
              <a href="/platform/integrations/"{% if page.url == '/platform/integrations/' %} class="is-current" aria-current="page"{% endif %}>Integrations &amp; APIs</a>
            </div>
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-building-store"></i> Solutions</div>
              {% for s in collections.solutions | sortByNavOrder %}<a href="{{ s.url }}"{% if page.url == s.url %} class="is-current" aria-current="page"{% endif %}>{{ s.data.navLabel or s.data.title }}</a>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="/case-studies/" class="nav-link{% if onCaseStudy %} nav-link-active{% endif %}">Case Studies <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown nav-cs">
          <div class="nav-cs-head">
            <span>Latest stories</span>
            <a href="/case-studies/">View all <i class="ti ti-arrow-right"></i></a>
          </div>
          <div class="nav-cs-grid">
            {% for cs in caseStudies | take(3) %}
            <a class="ncs-card" href="{{ cs.url }}"{% if cs.external %} target="_blank" rel="noopener"{% endif %}>
              {% if cs.photo %}<img class="ncs-photo" src="{{ cs.photo }}" alt="{{ cs.client }}" loading="lazy">{% endif %}
              <span class="ncs-scrim"></span>
              <span class="ncs-sector">{{ cs.sector }}</span>
              <span class="ncs-body">
                {% if cs.logo %}<img class="ncs-logo" src="{{ cs.logo }}" alt="{{ cs.client }}">{% else %}<span class="ncs-name">{{ cs.client }}</span>{% endif %}
                <span class="ncs-title">{{ cs.title }}</span>
                {% if cs.result %}<span class="ncs-result"><i class="ti {{ cs.resultIcon }}"></i> {{ cs.result }}</span>{% endif %}
              </span>
            </a>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="https://partners.teamworkcommerce.com/integrations" class="nav-link" target="_blank" rel="noopener">Partners <i class="ti ti-external-link" style="font-size:13px"></i></a>
      </div>
      {% if collections.resources.length %}
      <div class="nav-item">
        <span class="nav-link{% if not onCaseStudy and ("/blog/" in page.url or "/glossary/" in page.url or "/frequently-asked-questions/" in page.url) %} nav-link-active{% endif %}">Resources <i class="ti ti-chevron-down" style="font-size:14px"></i></span>
        <div class="nav-dropdown">
          {% for r in collections.resources %}{% if r.url != "/case-studies/" %}<a href="{{ r.url }}"{% if page.url == r.url %} class="is-current" aria-current="page"{% endif %}>{{ r.data.navLabel or r.data.title }}</a>{% endif %}{% endfor %}
        </div>
      </div>
      {% endif %}
      <div class="nav-item">
        {% set companyUrls = ["/about/", "/careers/", "/teamwork-cares/", "/press-room/"] %}
        <a href="/about/" class="nav-link{% if page.url in companyUrls %} nav-link-active{% endif %}">Company <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown">
          {% for c in companyUrls %}<a href="{{ c }}"{% if page.url == c %} class="is-current" aria-current="page"{% endif %}>{{ {"/about/":"About","/careers/":"Careers","/teamwork-cares/":"Teamwork Cares","/press-room/":"Press Room","/contact/":"Contact"}[c] }}</a>{% endfor %}
        </div>
      </div>
      <div class="nav-item">
        <a href="/contact/" class="nav-link{% if page.url == "/contact/" %} nav-link-active{% endif %}">Contact</a>
      </div>
    </div>
    <button class="nav-hamburger" id="navHamburger" aria-label="Menu"><i class="ti ti-menu-2"></i></button>
      <div class="nav-cta">
      <button class="btn-icon" id="themeToggle" aria-label="Toggle theme">
        <i class="ti ti-sun" id="themeIcon"></i>
      </button>
      <button class="btn-icon" aria-label="Change language">
        <i class="ti ti-world"></i>
      </button>
      <button class="btn btn-primary" onclick="window.location.href='/contact/'">Book a demo</button>
    </div>
  </div>

  <div class="nav-mobile-menu" id="navMobileMenu">
    <a href="/"{% if page.url == "/" %} class="is-current" aria-current="page"{% endif %}>Home</a>
    <a href="/platform/tcs/"{% if page.url == "/platform/tcs/" %} class="is-current" aria-current="page"{% endif %}>Teamwork Commerce Services</a>
    <div class="nav-mob-head">Commerce Apps</div>
    <a href="/platform/mobile-pos/"{% if page.url == "/platform/mobile-pos/" %} class="is-current" aria-current="page"{% endif %}>POS</a>
    <a href="/platform/teammate/"{% if page.url == "/platform/teammate/" %} class="is-current" aria-current="page"{% endif %}>TEAMMATE</a>
    <div class="nav-mob-head">Commerce Engine</div>
    <a href="/platform/pxp/"{% if page.url == "/platform/pxp/" %} class="is-current" aria-current="page"{% endif %}>PXP · Product</a>
    <a href="/platform/cxp/"{% if page.url == "/platform/cxp/" %} class="is-current" aria-current="page"{% endif %}>CXP · Customer</a>
    <a href="/platform/tap/"{% if page.url == "/platform/tap/" %} class="is-current" aria-current="page"{% endif %}>TAP · Identity</a>
    <a href="/platform/lms/"{% if page.url == "/platform/lms/" %} class="is-current" aria-current="page"{% endif %}>LMS · Training</a>
    <div class="nav-mob-head">Operations</div>
    <a href="/platform/oms/"{% if page.url == "/platform/oms/" %} class="is-current" aria-current="page"{% endif %}>Order Management</a>
    <a href="/platform/inventory-control/"{% if page.url == "/platform/inventory-control/" %} class="is-current" aria-current="page"{% endif %}>Inventory Control</a>
    <a href="/platform/rfid/"{% if page.url == "/platform/rfid/" %} class="is-current" aria-current="page"{% endif %}>RFID Solution</a>
    <a href="/platform/analytics/"{% if page.url == "/platform/analytics/" %} class="is-current" aria-current="page"{% endif %}>Analytics</a>
    <a href="/platform/shopper-services/"{% if page.url == "/platform/shopper-services/" %} class="is-current" aria-current="page"{% endif %}>Shopper Services</a>
    <a href="/platform/integrations/"{% if page.url == "/platform/integrations/" %} class="is-current" aria-current="page"{% endif %}>Integrations &amp; APIs</a>
    <a href="/case-studies/"{% if onCaseStudy %} class="is-current" aria-current="page"{% endif %}>Case Studies</a>
    <a href="https://partners.teamworkcommerce.com/integrations" target="_blank" rel="noopener">Partners</a>
    <div class="nav-mob-head">Solutions</div>
    {% for s in collections.solutions | sortByNavOrder %}<a href="{{ s.url }}"{% if page.url == s.url %} class="is-current" aria-current="page"{% endif %}>{{ s.data.navLabel or s.data.title }}</a>
    {% endfor %}
    {% for r in collections.resources %}<a href="{{ r.url }}"{% if page.url == r.url %} class="is-current" aria-current="page"{% endif %}>{{ r.data.navLabel or r.data.title }}</a>
    {% endfor %}
    <a href="/about/"{% if page.url == "/about/" %} class="is-current" aria-current="page"{% endif %}>About</a>
    <a href="/careers/"{% if page.url == "/careers/" %} class="is-current" aria-current="page"{% endif %}>Careers</a>
    <a href="/teamwork-cares/"{% if page.url == "/teamwork-cares/" %} class="is-current" aria-current="page"{% endif %}>Teamwork Cares</a>
    <a href="/partners/"{% if page.url == "/partners/" %} class="is-current" aria-current="page"{% endif %}>Partner Program</a>
    <a href="/press-room/"{% if page.url == "/press-room/" %} class="is-current" aria-current="page"{% endif %}>Press Room</a>
    <a href="/contact/"{% if page.url == "/contact/" %} class="is-current" aria-current="page"{% endif %}>Contact</a>
    <button class="btn btn-primary" onclick="window.location.href='/contact/'">Book a demo</button>
  </div>
</nav>
