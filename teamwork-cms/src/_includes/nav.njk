<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img class="logo-light" src="/assets/images/teamwork-logo-color.svg" alt="Teamwork Commerce">
      <img class="logo-dark" src="/assets/images/teamwork-logo-white.svg" alt="Teamwork Commerce">
    </a>
    <div class="nav-links">
      <div class="nav-item">
        <span class="nav-link{% if "/platform/" in page.url %} nav-link-active{% endif %}">Platform <i class="ti ti-chevron-down" style="font-size:14px"></i></span>
        <div class="nav-dropdown">
          {% for p in collections.platform | sortByNavOrder %}<a href="{{ p.url }}"{% if page.url == p.url %} class="is-current" aria-current="page"{% endif %}>{{ p.data.navLabel or p.data.title }}</a>{% endfor %}
        </div>
      </div>
      <div class="nav-item">
        <a href="/solutions/" class="nav-link{% if "/solutions/" in page.url %} nav-link-active{% endif %}">Solutions <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown">
          {% for s in collections.solutions | sortByNavOrder %}<a href="{{ s.url }}"{% if page.url == s.url %} class="is-current" aria-current="page"{% endif %}>{{ s.data.navLabel or s.data.title }}</a>{% endfor %}
        </div>
      </div>
      {% if collections.resources.length %}
      <div class="nav-item">
        <span class="nav-link{% if "/blog/" in page.url or "/case-studies/" in page.url or "/glossary/" in page.url or "/frequently-asked-questions/" in page.url %} nav-link-active{% endif %}">Resources <i class="ti ti-chevron-down" style="font-size:14px"></i></span>
        <div class="nav-dropdown">
          {% for r in collections.resources %}<a href="{{ r.url }}"{% if page.url == r.url %} class="is-current" aria-current="page"{% endif %}>{{ r.data.navLabel or r.data.title }}</a>{% endfor %}
        </div>
      </div>
      {% endif %}
      <div class="nav-item">
        {% set companyUrls = ["/about/", "/careers/", "/teamwork-cares/", "/partners/", "/press-room/", "/contact/"] %}
        <a href="/about/" class="nav-link{% if page.url in companyUrls %} nav-link-active{% endif %}">Company <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown">
          {% for c in companyUrls %}<a href="{{ c }}"{% if page.url == c %} class="is-current" aria-current="page"{% endif %}>{{ {"/about/":"About","/careers/":"Careers","/teamwork-cares/":"Teamwork Cares","/partners/":"Partners","/press-room/":"Press Room","/contact/":"Contact"}[c] }}</a>{% endfor %}
        </div>
      </div>
    </div>
    <button class="nav-hamburger" id="navHamburger" aria-label="Menu"><i class="ti ti-menu-2"></i></button>
      <div class="nav-cta">
      <button class="btn-icon" id="themeToggle" aria-label="Toggle theme">
        <i class="ti ti-sun" id="themeIcon"></i>
      </button>
      <button class="btn-icon" aria-label="Change language">
        <i class="ti ti-world"></i>
      </button>
      <button class="btn btn-primary" onclick="window.location.href='/contact/'">Book a demo</button>
    </div>
  </div>

  <div class="nav-mobile-menu" id="navMobileMenu">
    <a href="/"{% if page.url == "/" %} class="is-current" aria-current="page"{% endif %}>Home</a>
    {% for p in collections.platform | sortByNavOrder %}<a href="{{ p.url }}"{% if page.url == p.url %} class="is-current" aria-current="page"{% endif %}>{{ p.data.navLabel or p.data.title }}</a>
    {% endfor %}
    <a href="/solutions/"{% if page.url == "/solutions/" %} class="is-current" aria-current="page"{% endif %}>Solutions</a>
    {% for s in collections.solutions | sortByNavOrder %}<a href="{{ s.url }}"{% if page.url == s.url %} class="is-current" aria-current="page"{% endif %}>{{ s.data.navLabel or s.data.title }}</a>
    {% endfor %}
    {% for r in collections.resources %}<a href="{{ r.url }}"{% if page.url == r.url %} class="is-current" aria-current="page"{% endif %}>{{ r.data.navLabel or r.data.title }}</a>
    {% endfor %}
    <a href="/about/"{% if page.url == "/about/" %} class="is-current" aria-current="page"{% endif %}>About</a>
    <a href="/careers/"{% if page.url == "/careers/" %} class="is-current" aria-current="page"{% endif %}>Careers</a>
    <a href="/teamwork-cares/"{% if page.url == "/teamwork-cares/" %} class="is-current" aria-current="page"{% endif %}>Teamwork Cares</a>
    <a href="/partners/"{% if page.url == "/partners/" %} class="is-current" aria-current="page"{% endif %}>Partners</a>
    <a href="/press-room/"{% if page.url == "/press-room/" %} class="is-current" aria-current="page"{% endif %}>Press Room</a>
    <a href="/contact/"{% if page.url == "/contact/" %} class="is-current" aria-current="page"{% endif %}>Contact</a>
    <button class="btn btn-primary" onclick="window.location.href='/contact/'">Book a demo</button>
  </div>
</nav>
