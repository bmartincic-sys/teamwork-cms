{% set csUrls = [] %}
{% for cs in caseStudies %}{% if not cs.external %}{% set csUrls = (csUrls.push(cs.url), csUrls) %}{% endif %}{% endfor %}
{% set onCaseStudy = page.url == "/case-studies/" or page.url in csUrls %}
{% set newsUrls = [] %}
{% for np in collections.blogpost | inCategory("News") %}{% set newsUrls = (newsUrls.push(np.url), newsUrls) %}{% endfor %}
{% set onPressRelease = page.url in newsUrls %}
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img class="logo-light" src="/assets/images/teamwork-logo-color.svg" alt="Teamwork Commerce">
      <img class="logo-dark" src="/assets/images/teamwork-logo-white.svg" alt="Teamwork Commerce">
    </a>
    <div class="nav-links">
      <div class="nav-item">
        <a href="/platform/mobile-pos/" class="nav-link{% if "/platform/" in page.url or "/features/" in page.url or "/solutions/" in page.url %} nav-link-active{% endif %}">Platform <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown nav-mega">
          <a href="/platform/mobile-pos/" class="mega-overview{% if page.url == '/platform/mobile-pos/' %} is-current{% endif %}"{% if page.url == '/platform/mobile-pos/' %} aria-current="page"{% endif %}>
            <span class="mega-ov-icon"><i class="ti ti-device-tablet"></i></span>
            <span class="mega-ov-text">
              <strong>Point of Sale</strong>
              <em>The register at the core of everything else</em>
            </span>
            <i class="ti ti-arrow-right mega-ov-arrow"></i>
          </a>
          <div class="mega-cols">
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-shopping-cart"></i> Sell</div>
              <a href="/platform/mobile-pos/"{% if page.url == '/platform/mobile-pos/' %} class="is-current" aria-current="page"{% endif %}>Mobile POS</a>
              <a href="/platform/rfid/"{% if page.url == '/platform/rfid/' %} class="is-current" aria-current="page"{% endif %}>RFID &amp; Self-Checkout</a>
            </div>
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-database"></i> Know</div>
              <a href="/features/product-data/"{% if page.url == '/features/product-data/' %} class="is-current" aria-current="page"{% endif %}>Product Data &amp; Catalog</a>
              <a href="/features/customer-data/"{% if page.url == '/features/customer-data/' %} class="is-current" aria-current="page"{% endif %}>Customer Data &amp; Clienteling</a>
              <a href="/platform/analytics/"{% if page.url == '/platform/analytics/' %} class="is-current" aria-current="page"{% endif %}>Analytics &amp; Reporting</a>
            </div>
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-settings-cog"></i> Operate</div>
              <a href="/platform/inventory-control/"{% if page.url == '/platform/inventory-control/' %} class="is-current" aria-current="page"{% endif %}>Inventory Control</a>
              <a href="/platform/oms/"{% if page.url == '/platform/oms/' %} class="is-current" aria-current="page"{% endif %}>Order Management</a>
              <a href="/platform/scalability/"{% if page.url == '/platform/scalability/' %} class="is-current" aria-current="page"{% endif %}>Scaling &amp; Global</a>
              <a href="/platform/integrations/"{% if page.url == '/platform/integrations/' %} class="is-current" aria-current="page"{% endif %}>Integrations &amp; APIs</a>
              <a href="/platform/architecture/"{% if page.url == '/platform/architecture/' %} class="is-current" aria-current="page"{% endif %}>Architecture</a>
            </div>
            <div class="mega-col">
              <div class="mega-head"><i class="ti ti-users-group"></i> Team</div>
              <a href="/features/access-identity/"{% if page.url == '/features/access-identity/' %} class="is-current" aria-current="page"{% endif %}>Access &amp; Identity</a>
              <a href="/features/training/"{% if page.url == '/features/training/' %} class="is-current" aria-current="page"{% endif %}>Training &amp; Certification</a>
            </div>
          </div>
          <div class="mega-cols" style="margin-top: 10px;">
            <div class="mega-col" style="grid-column: 1 / -1;">
              <div class="mega-head"><i class="ti ti-building-store"></i> Solutions by industry</div>
              <div class="mega-ind">
                {% for sol in collections.solutions | sortByNavOrder %}
                <a class="mega-ind-item{% if page.url == sol.url %} is-current{% endif %}" href="{{ sol.url }}"{% if page.url == sol.url %} aria-current="page"{% endif %}>
                  <span class="mega-ind-ico"><i class="ti ti-{{ sol.data.navIcon or 'building-store' }}"></i></span>
                  <span class="mega-ind-text">
                    <strong>{{ sol.data.navLabel or sol.data.title }}</strong>
                    {% if sol.data.navBlurb %}<em>{{ sol.data.navBlurb }}</em>{% endif %}
                  </span>
                </a>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="/case-studies/" class="nav-link{% if onCaseStudy %} nav-link-active{% endif %}">Case Studies <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown nav-cs">
          <div class="nav-cs-head">
            <span>Latest stories</span>
            <a href="/case-studies/">View all <i class="ti ti-arrow-right"></i></a>
          </div>
          <div class="nav-cs-grid">
            {% for cs in caseStudies | take(3) %}
            <a class="ncs-card" href="{{ cs.url }}"{% if cs.external %} target="_blank" rel="noopener"{% endif %}>
              {% if cs.photo %}<img class="ncs-photo" src="{{ cs.photo }}" alt="{{ cs.client }}" loading="lazy">{% endif %}
              <span class="ncs-scrim"></span>
              <span class="ncs-sector">{{ cs.sector }}</span>
              <span class="ncs-body">
                {% if cs.logo %}<img class="ncs-logo" src="{{ cs.logo }}" alt="{{ cs.client }}">{% else %}<span class="ncs-name">{{ cs.client }}</span>{% endif %}
                <span class="ncs-title">{{ cs.title }}</span>
                {% if cs.result %}<span class="ncs-result"><i class="ti {{ cs.resultIcon }}"></i> {{ cs.result }}</span>{% endif %}
              </span>
            </a>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="https://partners.teamworkcommerce.com/integrations" class="nav-link" target="_blank" rel="noopener">Partners <i class="ti ti-external-link" style="font-size:13px"></i></a>
      </div>
      {% if collections.resources.length %}
      <div class="nav-item">
        <span class="nav-link{% if not onCaseStudy and (onPressRelease or "/blog/" in page.url or "/press-room/" in page.url or "/technical-evaluation/" in page.url) %} nav-link-active{% endif %}">Resources <i class="ti ti-chevron-down" style="font-size:14px"></i></span>
        <div class="nav-dropdown nav-cs">
          <div class="nav-cs-head">
            <span>Latest from the blog</span>
            <a href="/blog/">View all <i class="ti ti-arrow-right"></i></a>
          </div>
          <div class="nav-split">
            {% for post in collections.blogpost | recentPosts(1) %}
            <a class="ncs-card ncs-card-wide" href="{{ post.url }}">
              <img class="ncs-photo" src="/assets/images/blog/real/{{ post.fileSlug }}.jpg" alt="{{ post.data.title }}" loading="lazy">
              <span class="ncs-scrim"></span>
              {% if post.data.category %}<span class="ncs-sector">{{ post.data.category }}</span>{% endif %}
              <span class="ncs-body">
                <span class="ncs-name">{{ post.data.date | formatDate }}</span>
                <span class="ncs-title">{{ post.data.title }}</span>
              </span>
            </a>
            {% endfor %}
            <div class="nav-rows">
              {% set resRows = [
                ["/blog/", "ti-article", "Blog", "Insights, trends, and how retailers are operating"],
                ["/press-room/", "ti-news", "Press Room", "Announcements and media contacts"],
                ["/technical-evaluation/", "ti-shield-lock", "Technical Evaluation", "Architecture, security, and migration"]
              ] %}
              {% for r in resRows %}
              <a class="nav-row" href="{{ r[0] }}"{% if page.url == r[0] %} aria-current="page"{% endif %}>
                <span class="nav-row-ico"><i class="ti {{ r[1] }}"></i></span>
                <span class="nav-row-text">
                  <strong>{{ r[2] }}</strong>
                  <em>{{ r[3] }}</em>
                </span>
                <i class="ti ti-arrow-right nav-row-arrow"></i>
              </a>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
      {% endif %}
      <div class="nav-item">
        {% set companyUrls = ["/about/", "/careers/", "/teamwork-cares/"] %}
        {% set companyIcons = {"/about/":"ti-building","/careers/":"ti-briefcase","/teamwork-cares/":"ti-heart-handshake"} %}
        {% set companyLabels = {"/about/":"About","/careers/":"Careers","/teamwork-cares/":"Teamwork Cares"} %}
        <a href="/about/" class="nav-link{% if page.url in companyUrls %} nav-link-active{% endif %}">Company <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
        <div class="nav-dropdown nav-cs nav-cs-solo">
          <div class="nav-rows nav-rows-solo">
              {% set companyDesc = {
                "/about/": "Who we are and how we got here",
                "/careers/": "Open roles across the company",
                "/teamwork-cares/": "How our team gives back"
              } %}
              {% for c in companyUrls %}
              <a class="nav-row" href="{{ c }}"{% if page.url == c %} aria-current="page"{% endif %}>
                <span class="nav-row-ico"><i class="ti {{ companyIcons[c] }}"></i></span>
                <span class="nav-row-text">
                  <strong>{{ companyLabels[c] }}</strong>
                  <em>{{ companyDesc[c] }}</em>
                </span>
                <i class="ti ti-arrow-right nav-row-arrow"></i>
              </a>
              {% endfor %}
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="/contact/" class="nav-link{% if page.url == "/contact/" %} nav-link-active{% endif %}">Contact</a>
      </div>
    </div>
    <button class="nav-hamburger" id="navHamburger" aria-label="Menu"><i class="ti ti-menu-2"></i></button>
      <div class="nav-cta">
      <button class="btn-icon" id="themeToggle" aria-label="Toggle theme">
        <i class="ti ti-sun" id="themeIcon"></i>
      </button>
      <button class="btn-icon" aria-label="Change language">
        <i class="ti ti-world"></i>
      </button>
      <a href="/demo/" class="btn btn-primary">Book a demo</a>
    </div>
  </div>

  <div class="nav-mobile-menu" id="navMobileMenu">
    <a href="/"{% if page.url == "/" %} class="is-current" aria-current="page"{% endif %}>Home</a>
    <div class="nav-mob-head">Sell</div>
    <a href="/platform/mobile-pos/"{% if page.url == "/platform/mobile-pos/" %} class="is-current" aria-current="page"{% endif %}>Mobile POS</a>
    <a href="/platform/rfid/"{% if page.url == "/platform/rfid/" %} class="is-current" aria-current="page"{% endif %}>RFID &amp; Self-Checkout</a>
    <div class="nav-mob-head">Know</div>
    <a href="/features/product-data/"{% if page.url == "/features/product-data/" %} class="is-current" aria-current="page"{% endif %}>Product Data &amp; Catalog</a>
    <a href="/features/customer-data/"{% if page.url == "/features/customer-data/" %} class="is-current" aria-current="page"{% endif %}>Customer Data &amp; Clienteling</a>
    <a href="/platform/analytics/"{% if page.url == "/platform/analytics/" %} class="is-current" aria-current="page"{% endif %}>Analytics &amp; Reporting</a>
    <div class="nav-mob-head">Operate</div>
    <a href="/platform/inventory-control/"{% if page.url == "/platform/inventory-control/" %} class="is-current" aria-current="page"{% endif %}>Inventory Control</a>
    <a href="/platform/oms/"{% if page.url == "/platform/oms/" %} class="is-current" aria-current="page"{% endif %}>Order Management</a>
    <a href="/platform/scalability/"{% if page.url == "/platform/scalability/" %} class="is-current" aria-current="page"{% endif %}>Scaling &amp; Global</a>
    <a href="/platform/integrations/"{% if page.url == "/platform/integrations/" %} class="is-current" aria-current="page"{% endif %}>Integrations &amp; APIs</a>
    <div class="nav-mob-head">Team</div>
    <a href="/features/access-identity/"{% if page.url == "/features/access-identity/" %} class="is-current" aria-current="page"{% endif %}>Access &amp; Identity</a>
    <a href="/features/training/"{% if page.url == "/features/training/" %} class="is-current" aria-current="page"{% endif %}>Training &amp; Certification</a>
    <a href="/case-studies/"{% if onCaseStudy %} class="is-current" aria-current="page"{% endif %}>Case Studies</a>
    <a href="https://partners.teamworkcommerce.com/integrations" target="_blank" rel="noopener">Partners</a>
    <div class="nav-mob-head">Solutions by industry</div>
    {% for s in collections.solutions | sortByNavOrder %}<a class="nav-mob-ind{% if page.url == s.url %} is-current{% endif %}" href="{{ s.url }}"{% if page.url == s.url %} aria-current="page"{% endif %}><i class="ti ti-{{ s.data.navIcon or 'building-store' }}"></i> {{ s.data.navLabel or s.data.title }}</a>
    {% endfor %}
    <div class="nav-mob-head">Resources</div>
    <a href="/blog/"{% if "/blog/" in page.url %} class="is-current" aria-current="page"{% endif %}>Blog</a>
    <a href="/press-room/"{% if page.url == "/press-room/" %} class="is-current" aria-current="page"{% endif %}>Press Room</a>
    <a href="/technical-evaluation/"{% if page.url == "/technical-evaluation/" %} class="is-current" aria-current="page"{% endif %}>Technical Evaluation</a>
    <div class="nav-mob-head">Company</div>
    <a href="/about/"{% if page.url == "/about/" %} class="is-current" aria-current="page"{% endif %}>About</a>
    <a href="/careers/"{% if page.url == "/careers/" %} class="is-current" aria-current="page"{% endif %}>Careers</a>
    <a href="/teamwork-cares/"{% if page.url == "/teamwork-cares/" %} class="is-current" aria-current="page"{% endif %}>Teamwork Cares</a>
    <a href="/contact/"{% if page.url == "/contact/" %} class="is-current" aria-current="page"{% endif %}>Contact</a>
    <a href="/demo/" class="btn btn-primary">Book a demo</a>
    <div class="nav-mob-tools">
      <button type="button" id="themeToggleMob" aria-label="Toggle theme"><i class="ti ti-moon" id="themeIconMob"></i> Theme</button>
      <button type="button" aria-label="Change language"><i class="ti ti-world"></i> English (US)</button>
    </div>
  </div>
</nav>
