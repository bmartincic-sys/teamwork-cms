{#- Site search: an overlay opened from the nav or with Cmd/Ctrl+K.

    The index is fetched on first open, not on page load, so a visitor who
    never searches never pays for it. Results are scored rather than filtered:
    a title hit outranks a heading hit outranks body text, and every term has
    to appear somewhere, so two words narrow instead of widen.

    FAQ answers are indexed as their own records. Someone searching "does it
    work offline" should land on the answer, not on the page holding it, so
    those results deep-link to the question and open it on arrival. -#}

<div class="sx-overlay" id="sxOverlay" hidden>
  <div class="sx-panel" role="dialog" aria-modal="true" aria-label="Search this site">
    <div class="sx-head">
      <i class="ti ti-search sx-head-icon" aria-hidden="true"></i>
      <input type="search" id="sxInput" class="sx-input" placeholder="Search the site"
             autocomplete="off" autocorrect="off" spellcheck="false"
             aria-label="Search" aria-controls="sxResults" aria-expanded="false">
      <button type="button" class="sx-close" id="sxClose" aria-label="Close search">Esc</button>
    </div>
    <div class="sx-results" id="sxResults" role="listbox" aria-label="Search results"></div>
    <div class="sx-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to open</span>
      <span><kbd>esc</kbd> to close</span>
    </div>
  </div>
</div>

<script>
(function () {
  var overlay = document.getElementById("sxOverlay");
  var input = document.getElementById("sxInput");
  var list = document.getElementById("sxResults");
  if (!overlay || !input || !list) return;

  var index = null, loading = false, items = [], active = -1, lastFocus = null;

  function slugify(s) {
    return s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "").slice(0, 60);
  }

  /* Give every FAQ an id matching the one the index generated, so a result can
     deep-link to it. Done here rather than in 174 places of markup. */
  function tagFaqs() {
    document.querySelectorAll(".faq-item").forEach(function (item) {
      if (item.id) return;
      var q = item.querySelector(".faq-question");
      if (!q) return;
      var id = "faq-" + slugify(q.textContent.trim());
      // The hub can repeat a question; a second copy keeps no id rather than
      // a duplicate one. The index always points at the first.
      if (!document.getElementById(id)) item.id = id;
    });
  }

  /* Arriving on a FAQ deep link: open it and bring it into view. */
  function openFromHash() {
    if (!/^#faq-/.test(location.hash)) return;
    var el = document.getElementById(location.hash.slice(1));
    if (!el) return;
    el.classList.add("open");
    var btn = el.querySelector(".faq-question");
    if (btn) btn.setAttribute("aria-expanded", "true");
    el.scrollIntoView({ block: "center" });
  }

  function load() {
    if (index || loading) return Promise.resolve();
    loading = true;
    return fetch("/search-index.json")
      .then(function (r) { return r.json(); })
      .then(function (d) { index = d; loading = false; })
      .catch(function () { loading = false; index = []; });
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"]/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
    });
  }

  /* Highlight the matched terms in a snippet, longest first so that a short
     term does not break a longer one it sits inside. */
  function mark(text, terms) {
    var out = escapeHtml(text);
    terms.slice().sort(function (a, b) { return b.length - a.length; }).forEach(function (t) {
      if (t.length < 2) return;
      out = out.replace(new RegExp("(" + t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "ig"), "\u0001$1\u0002");
    });
    return out.replace(/\u0001/g, "<mark>").replace(/\u0002/g, "</mark>");
  }

  function score(rec, terms) {
    var title = (rec.t || "").toLowerCase();
    var head = (rec.h || "").toLowerCase();
    var desc = (rec.d || "").toLowerCase();
    var body = (rec.x || "").toLowerCase();
    var total = 0;
    for (var i = 0; i < terms.length; i++) {
      var t = terms[i], s = 0;
      if (title === t) s += 120;
      else if (title.indexOf(t) === 0) s += 70;
      else if (title.indexOf(t) > -1) s += 50;
      if (head.indexOf(t) > -1) s += 18;
      if (desc.indexOf(t) > -1) s += 12;
      if (body.indexOf(t) > -1) s += 6;
      if (!s) return 0;                 // every term must appear somewhere
      total += s;
    }
    if (rec.k === "faq") total += 8;    // a question usually answers a question
    return total;
  }

  function render(q) {
    var terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    list.innerHTML = "";
    items = [];
    active = -1;
    input.setAttribute("aria-expanded", terms.length ? "true" : "false");
    if (!terms.length || !index) return;

    var hits = [];
    for (var i = 0; i < index.length; i++) {
      var s = score(index[i], terms);
      if (s) hits.push({ r: index[i], s: s });
    }
    hits.sort(function (a, b) { return b.s - a.s; });

    if (!hits.length) {
      list.innerHTML = '<p class="sx-empty">No results for <strong>' + escapeHtml(q) + "</strong></p>";
      return;
    }

    var frag = document.createDocumentFragment();
    hits.slice(0, 24).forEach(function (h) {
      var a = document.createElement("a");
      a.className = "sx-hit";
      a.href = h.r.u;
      a.setAttribute("role", "option");
      a.innerHTML =
        '<span class="sx-hit-kind">' + escapeHtml(h.r.s) + "</span>" +
        '<span class="sx-hit-title">' + mark(h.r.t || "", terms) + "</span>" +
        '<span class="sx-hit-snip">' + mark((h.r.d || h.r.x || "").slice(0, 150), terms) + "</span>";
      frag.appendChild(a);
      items.push(a);
    });
    list.appendChild(frag);
  }

  function setActive(i) {
    if (!items.length) return;
    if (active > -1 && items[active]) items[active].classList.remove("is-active");
    active = (i + items.length) % items.length;
    items[active].classList.add("is-active");
    items[active].setAttribute("aria-selected", "true");
    items[active].scrollIntoView({ block: "nearest" });
  }

  function open() {
    lastFocus = document.activeElement;
    overlay.hidden = false;
    document.body.style.overflow = "hidden";
    load().then(function () { if (input.value) render(input.value); });
    setTimeout(function () { input.focus(); input.select(); }, 20);
  }

  function close() {
    overlay.hidden = true;
    document.body.style.overflow = "";
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.addEventListener("click", function (e) {
    if (e.target.closest("[data-search-open]")) { e.preventDefault(); open(); }
  });
  document.getElementById("sxClose").addEventListener("click", close);
  overlay.addEventListener("mousedown", function (e) { if (e.target === overlay) close(); });

  input.addEventListener("input", function () { render(input.value.trim()); });

  document.addEventListener("keydown", function (e) {
    var k = e.key.toLowerCase();
    if ((e.metaKey || e.ctrlKey) && k === "k") { e.preventDefault(); overlay.hidden ? open() : close(); return; }
    if (overlay.hidden) return;
    if (k === "escape") { e.preventDefault(); close(); }
    else if (k === "arrowdown") { e.preventDefault(); setActive(active + 1); }
    else if (k === "arrowup") { e.preventDefault(); setActive(active - 1); }
    else if (k === "enter" && active > -1 && items[active]) { e.preventDefault(); items[active].click(); }
  });

  /* This script is included at the top of <body>, so the FAQ items further
     down do not exist yet when it runs. The listeners above delegate on
     document and are fine early; tagging and deep-link opening must wait. */
  function ready() { tagFaqs(); openFromHash(); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", ready);
  else ready();
  window.addEventListener("hashchange", openFromHash);
})();
</script>
